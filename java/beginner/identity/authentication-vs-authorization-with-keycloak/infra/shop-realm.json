{
  "realm": "shop",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 15,
  "ssoSessionIdleTimeout": 1800,
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      { "name": "customer", "description": "A shopper who may see their own orders" },
      { "name": "support", "description": "Staff who may see any order" },
      { "name": "admin", "description": "Staff who may also see the sales report" }
    ]
  },
  "users": [
    {
      "username": "ana", "enabled": true, "emailVerified": true, "firstName": "Ana", "lastName": "Shopper", "email": "ana@shop.example",
      "credentials": [ { "type": "password", "value": "demo-password", "temporary": false } ],
      "realmRoles": [ "customer" ]
    },
    {
      "username": "sam", "enabled": true, "emailVerified": true, "firstName": "Sam", "lastName": "Support", "email": "sam@shop.example",
      "credentials": [ { "type": "password", "value": "demo-password", "temporary": false } ],
      "realmRoles": [ "support" ]
    },
    {
      "username": "root", "enabled": true, "emailVerified": true, "firstName": "Root", "lastName": "Admin", "email": "root@shop.example",
      "credentials": [ { "type": "password", "value": "demo-password", "temporary": false } ],
      "realmRoles": [ "admin" ]
    },
    {
      "username": "temp-admin", "enabled": true, "emailVerified": true, "firstName": "Temp", "lastName": "Admin", "email": "temp-admin@shop.example",
      "credentials": [ { "type": "password", "value": "demo-password", "temporary": false } ],
      "realmRoles": [ "admin" ]
    },
    {
      "username": "service-account-shop-batch", "enabled": true, "serviceAccountClientId": "shop-batch",
      "realmRoles": [ "support" ]
    }
  ],
  "clients": [
    {
      "clientId": "shop-web",
      "name": "The shop's web front end (a public client: it has no secret, and uses PKCE)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [ "http://127.0.0.1:9/callback" ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "shop-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "shop-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    },
    {
      "clientId": "shop-batch",
      "name": "A nightly job (a confidential client: it has a secret and no user)",
      "enabled": true,
      "publicClient": false,
      "secret": "demo-batch-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "shop-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": { "included.custom.audience": "shop-api", "access.token.claim": "true", "id.token.claim": "false" }
        }
      ]
    }
  ]
}
