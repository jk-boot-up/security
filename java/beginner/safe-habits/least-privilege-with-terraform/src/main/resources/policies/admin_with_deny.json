{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowEverything",
      "Effect": "Allow",
      "Action": "*",
      "Resource": "*"
    },
    {
      "Sid": "NeverTouchSecrets",
      "Effect": "Deny",
      "Action": [
        "s3:*",
        "kms:*"
      ],
      "Resource": [
        "arn:aws:s3:::shop-secrets/*",
        "arn:aws:s3:::shop-secrets",
        "arn:aws:kms:eu-west-1:000000000000:key/*"
      ]
    }
  ]
}
