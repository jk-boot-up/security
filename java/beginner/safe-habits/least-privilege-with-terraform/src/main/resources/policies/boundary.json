{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadOnlyShopData",
      "Effect": "Allow",
      "Action": [
        "s3:List*",
        "s3:Get*",
        "dynamodb:Scan",
        "dynamodb:Query",
        "dynamodb:GetItem"
      ],
      "Resource": "*"
    },
    {
      "Sid": "NoSecrets",
      "Effect": "Deny",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::shop-secrets/*",
        "arn:aws:s3:::shop-secrets"
      ]
    }
  ]
}
