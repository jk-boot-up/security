{
  "realm": "bank",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 5,
  "ssoSessionIdleTimeout": 1800,
  "revokeRefreshToken": true,
  "refreshTokenMaxReuse": 0,
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Customer",
      "email": "ana@bank.example",
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ],
      "id": "a0a0a0a0-0000-4000-8000-000000000001"
    },
    {
      "username": "ben",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ben",
      "lastName": "Customer",
      "email": "ben@bank.example",
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ],
      "id": "b0b0b0b0-0000-4000-8000-000000000002"
    }
  ],
  "clientScopes": [
    {
      "name": "accounts.read",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Read your accounts"
      }
    },
    {
      "name": "payments.write",
      "protocol": "openid-connect",
      "attributes": {
        "include.in.token.scope": "true",
        "display.on.consent.screen": "true",
        "consent.screen.text": "Make payments"
      }
    }
  ],
  "clients": [
    {
      "clientId": "budget-app",
      "name": "A budgeting app on a phone (a public client: no secret, PKCE required)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://budget.example/callback"
      ],
      "defaultClientScopes": [
        "accounts.read"
      ],
      "optionalClientScopes": [],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "accounts-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "accounts-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        },
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ],
      "consentRequired": true
    },
    {
      "clientId": "statements-service",
      "name": "The statements service (a confidential client: it has a secret)",
      "enabled": true,
      "publicClient": false,
      "secret": "demo-statements-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "https://statements.example/callback"
      ],
      "defaultClientScopes": [
        "accounts.read"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "sub",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-sub-mapper",
          "config": {
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ]
}