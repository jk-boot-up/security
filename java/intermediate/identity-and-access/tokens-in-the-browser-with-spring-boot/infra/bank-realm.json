{
  "realm": "bank",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "users": [
    {
      "id": "a0a0a0a0-0000-4000-8000-000000000001",
      "username": "ana", "enabled": true, "emailVerified": true, "firstName": "Ana", "lastName": "Customer", "email": "ana@bank.example",
      "credentials": [ { "type": "password", "value": "demo-password", "temporary": false } ]
    }
  ],
  "clientScopes": [
    { "name": "accounts.read", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } },
    { "name": "payments.write", "protocol": "openid-connect", "attributes": { "include.in.token.scope": "true", "display.on.consent.screen": "false" } }
  ],
  "clients": [
    {
      "clientId": "bank-spa",
      "name": "The bank's single-page app, which keeps its tokens in the browser (a public client with PKCE)",
      "enabled": true, "publicClient": true, "standardFlowEnabled": true, "implicitFlowEnabled": false, "directAccessGrantsEnabled": false,
      "redirectUris": [ "https://app.bank.example/callback" ],
      "defaultClientScopes": [ "accounts.read", "payments.write" ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        { "name": "accounts-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "accounts-api", "access.token.claim": "true", "id.token.claim": "false" } },
        { "name": "sub", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper", "config": { "access.token.claim": "true", "introspection.token.claim": "true" } }
      ]
    },
    {
      "clientId": "bank-spa-dpop",
      "name": "The same single-page app, with access tokens bound to a key it holds (DPoP)",
      "enabled": true, "publicClient": true, "standardFlowEnabled": true, "implicitFlowEnabled": false, "directAccessGrantsEnabled": false,
      "redirectUris": [ "https://app.bank.example/callback" ],
      "defaultClientScopes": [ "accounts.read", "payments.write" ],
      "attributes": { "pkce.code.challenge.method": "S256", "dpop.bound.access.tokens": "true" },
      "protocolMappers": [
        { "name": "accounts-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "accounts-api", "access.token.claim": "true", "id.token.claim": "false" } },
        { "name": "sub", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper", "config": { "access.token.claim": "true", "introspection.token.claim": "true" } }
      ]
    },
    {
      "clientId": "bank-bff",
      "name": "The bank's backend for the frontend (a confidential client that holds the tokens on the server)",
      "enabled": true, "publicClient": false, "secret": "demo-bff-secret", "standardFlowEnabled": true, "implicitFlowEnabled": false, "directAccessGrantsEnabled": false,
      "redirectUris": [ "http://127.0.0.1:${BFF_PORT}/login/oauth2/code/keycloak" ],
      "defaultClientScopes": [ "accounts.read", "payments.write" ],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        { "name": "accounts-api-audience", "protocol": "openid-connect", "protocolMapper": "oidc-audience-mapper", "config": { "included.custom.audience": "accounts-api", "access.token.claim": "true", "id.token.claim": "false" } },
        { "name": "sub", "protocol": "openid-connect", "protocolMapper": "oidc-sub-mapper", "config": { "access.token.claim": "true", "introspection.token.claim": "true" } }
      ]
    }
  ]
}
