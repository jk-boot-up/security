{
  "realm": "bank",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "users": [
    {
      "username": "ana",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Ana",
      "lastName": "Customer",
      "email": "ana@bank.example",
      "credentials": [
        {
          "type": "password",
          "value": "demo-password",
          "temporary": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "http://127.0.0.1:${SP_PORT}/saml2/service-provider-metadata/keycloak",
      "name": "The shop",
      "protocol": "saml",
      "enabled": true,
      "publicClient": false,
      "frontchannelLogout": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:${SP_PORT}/login/saml2/sso/keycloak"
      ],
      "attributes": {
        "saml.authnstatements": "true",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.client.signature": "false",
        "saml.force.post.binding": "true",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "username",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml_assertion_consumer_url_post": "http://127.0.0.1:${SP_PORT}/login/saml2/sso/keycloak",
        "saml.encrypt": "false",
        "saml.assertion.lifespan": "2"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic",
            "friendly.name": "email"
          }
        }
      ]
    },
    {
      "clientId": "http://other-shop.example/saml/metadata",
      "name": "Another shop",
      "protocol": "saml",
      "enabled": true,
      "publicClient": false,
      "frontchannelLogout": true,
      "standardFlowEnabled": true,
      "redirectUris": [
        "http://127.0.0.1:${SP_PORT}/login/saml2/sso/keycloak"
      ],
      "attributes": {
        "saml.authnstatements": "true",
        "saml.server.signature": "true",
        "saml.assertion.signature": "true",
        "saml.client.signature": "false",
        "saml.force.post.binding": "true",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "username",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_signature_canonicalization_method": "http://www.w3.org/2001/10/xml-exc-c14n#",
        "saml_assertion_consumer_url_post": "http://127.0.0.1:${SP_PORT}/login/saml2/sso/keycloak",
        "saml.encrypt": "false"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic",
            "friendly.name": "email"
          }
        }
      ]
    }
  ]
}