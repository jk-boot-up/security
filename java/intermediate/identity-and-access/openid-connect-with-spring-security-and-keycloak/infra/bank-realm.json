{
  "realm": "bank",
  "enabled": true,
  "sslRequired": "external",
  "accessTokenLifespan": 300,
  "ssoSessionIdleTimeout": 1800,
  "registrationAllowed": false,
  "bruteForceProtected": true,
  "users": [
    {
      "id": "a0a0a0a0-0000-4000-8000-000000000001",
      "username": "ana", "enabled": true, "emailVerified": true, "firstName": "Ana", "lastName": "Customer", "email": "ana@mail.example",
      "credentials": [ { "type": "password", "value": "demo-password", "temporary": false } ]
    }
  ],
  "clients": [
    {
      "clientId": "store-web",
      "name": "The online store (a confidential client that signs shoppers in with their bank login)",
      "enabled": true,
      "publicClient": false,
      "secret": "demo-store-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [ "http://127.0.0.1:${STORE_PORT}/login/oauth2/code/bank" ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://127.0.0.1:${STORE_PORT}/",
        "backchannel.logout.url": "http://host.docker.internal:${STORE_PORT}/logout/connect/back-channel/bank",
        "backchannel.logout.session.required": "true",
        "backchannel.logout.revoke.offline.tokens": "false"
      }
    }
  ]
}
