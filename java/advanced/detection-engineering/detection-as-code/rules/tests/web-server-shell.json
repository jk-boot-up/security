{
 "rule": "web-server-shell",
 "cases": [
  {"name": "nginx starts sh", "match": true, "events": [{"ParentImage": "/usr/sbin/nginx", "Image": "/bin/sh", "CommandLine": "sh -c id", "User": "www-data"}]},
  {"name": "httpd starts bash", "match": true, "events": [{"ParentImage": "/usr/sbin/httpd", "Image": "/bin/bash", "CommandLine": "bash -i", "User": "apache"}]},
  {"name": "php-fpm starts dash", "match": true, "events": [{"ParentImage": "/usr/sbin/php-fpm", "Image": "/bin/dash", "CommandLine": "dash -c ls", "User": "www-data"}]},
  {"name": "the application server starts sh", "match": true, "events": [{"ParentImage": "/usr/lib/jvm/java-21/bin/java", "Image": "/bin/sh", "CommandLine": "sh -c whoami", "User": "tomcat"}]},
  {"name": "nginx starts a worker, not a shell", "match": false, "events": [{"ParentImage": "/usr/sbin/nginx", "Image": "/usr/bin/ls", "CommandLine": "ls", "User": "www-data"}]},
  {"name": "a person's bash starts sh", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c id", "User": "emp100"}]},
  {"name": "the health check run by the application server", "match": false, "events": [{"ParentImage": "/usr/lib/jvm/java-21/bin/java", "Image": "/bin/sh", "CommandLine": "/bin/sh -c /opt/bank/bin/healthcheck --deep", "User": "tomcat"}]},
  {"name": "php-fpm starts python", "match": false, "events": [{"ParentImage": "/usr/sbin/php-fpm", "Image": "/usr/bin/python3", "CommandLine": "python3 -c pass", "User": "www-data"}]},
  {"name": "a shell that only mentions the health check later", "match": true, "events": [{"ParentImage": "/usr/lib/jvm/java-21/bin/java", "Image": "/bin/sh", "CommandLine": "/bin/sh -c 'id # /opt/bank/bin/healthcheck'", "User": "tomcat"}]}
 ]
}
