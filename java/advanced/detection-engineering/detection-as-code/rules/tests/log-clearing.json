{
 "rule": "log-clearing",
 "cases": [
  {"name": "rm in the log folder", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/bin/rm", "CommandLine": "rm -rf /var/log/secure", "User": "emp100"}]},
  {"name": "shred in the log folder", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/bin/shred", "CommandLine": "shred -u /var/log/wtmp", "User": "emp100"}]},
  {"name": "truncate in the log folder", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/bin/truncate", "CommandLine": "truncate -s 0 /var/log/auth.log", "User": "emp100"}]},
  {"name": "history cleared", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c 'history -c'", "User": "emp100"}]},
  {"name": "history file unset", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/bash", "CommandLine": "bash -c 'unset HISTFILE'", "User": "emp100"}]},
  {"name": "wevtutil clears a log", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "C:\\Windows\\System32\\wevtutil.exe", "CommandLine": "wevtutil.exe cl Security", "User": "emp100"}]},
  {"name": "event 1102", "match": true, "events": [{"EventType": "winlog", "EventID": "1102", "User": "svc-deploy"}]},
  {"name": "rm outside the log folder", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/bin/rm", "CommandLine": "rm /tmp/report.csv", "User": "emp100"}]},
  {"name": "ls in the log folder", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/bin/ls", "CommandLine": "ls /var/log/", "User": "emp100"}]},
  {"name": "wevtutil reads a log", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "C:\\Windows\\System32\\wevtutil.exe", "CommandLine": "wevtutil qe Security", "User": "emp100"}]},
  {"name": "another program with the same words", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "C:\\Windows\\System32\\cmd.exe", "CommandLine": "cmd.exe echo x cl y", "User": "emp100"}]},
  {"name": "another event id", "match": false, "events": [{"EventType": "winlog", "EventID": "4624", "User": "emp100"}]},
  {"name": "logrotate removes old logs", "match": false, "events": [{"ParentImage": "/usr/sbin/logrotate", "Image": "/usr/bin/rm", "CommandLine": "rm -f /var/log/bank/app.log.5.gz", "User": "root"}]}
 ]
}
