{
 "rule": "failed-login-burst",
 "cases": [
  {"name": "ten failures from one address 25 seconds apart", "match": true, "events": [{"t": 0, "repeat": 10, "every": 25, "EventType": "login", "outcome": "failure", "src_ip": "203.0.113.5", "User": "cust1"}]},
  {"name": "twelve users from one address 10 seconds apart", "match": true, "events": [{"t": 0, "repeat": 12, "every": 10, "EventType": "login", "outcome": "failure", "src_ip": "203.0.113.6", "User": "cust2"}]},
  {"name": "nine failures", "match": false, "events": [{"t": 0, "repeat": 9, "every": 25, "EventType": "login", "outcome": "failure", "src_ip": "203.0.113.5", "User": "cust1"}]},
  {"name": "ten failures over 25 minutes", "match": false, "events": [{"t": 0, "repeat": 10, "every": 150, "EventType": "login", "outcome": "failure", "src_ip": "203.0.113.5", "User": "cust1"}]},
  {"name": "successes", "match": false, "events": [{"t": 0, "repeat": 30, "every": 5, "EventType": "login", "outcome": "success", "src_ip": "10.20.1.1", "User": "emp100"}]},
  {"name": "failures on another event type", "match": false, "events": [{"t": 0, "repeat": 12, "every": 5, "EventType": "web", "outcome": "failure", "src_ip": "10.20.1.1", "User": "emp100"}]}
 ]
}
