{
 "rule": "credential-dump-tools",
 "cases": [
  {"name": "mimikatz by name", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/opt/x/mimikatz", "CommandLine": "x", "User": "emp100"}]},
  {"name": "mimikatz.exe by name", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "C:\\Users\\Public\\mimikatz.exe", "CommandLine": "x", "User": "emp100"}]},
  {"name": "procdump.exe", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "C:\\Tools\\procdump.exe", "CommandLine": "x", "User": "emp100"}]},
  {"name": "secretsdump", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/local/bin/secretsdump.py", "CommandLine": "x", "User": "emp100"}]},
  {"name": "lazagne", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/opt/tools/lazagne", "CommandLine": "x", "User": "emp100"}]},
  {"name": "mimikatz only in the arguments", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/bash", "CommandLine": "bash run mimikatz", "User": "emp100"}]},
  {"name": "a sekurlsa argument", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "C:\\Windows\\Temp\\m.exe", "CommandLine": "m.exe sekurlsa::logonpasswords", "User": "emp100"}]},
  {"name": "a lsass dump file", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/bash", "CommandLine": "bash read lsass.dmp", "User": "emp100"}]},
  {"name": "cp of the shadow file", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/cp", "CommandLine": "cp /etc/shadow /tmp/s", "User": "emp100"}]},
  {"name": "cat of the shadow file", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/cat", "CommandLine": "cat /etc/shadow", "User": "emp100"}]},
  {"name": "tar of the shadow file", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/tar", "CommandLine": "tar czf x.tgz /etc/shadow", "User": "emp100"}]},
  {"name": "cat of another file", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/bin/cat", "CommandLine": "cat /etc/hosts", "User": "emp100"}]},
  {"name": "an editor on the shadow file", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/bin/vi", "CommandLine": "vi /etc/shadow", "User": "emp100"}]},
  {"name": "the hunting account searching for the name", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/bin/grep", "CommandLine": "grep -ril mimikatz /srv/shared/iocs", "User": "sec-hunt"}]},
  {"name": "an ordinary tool", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/bin/ls", "CommandLine": "ls -la", "User": "emp100"}]}
 ]
}
