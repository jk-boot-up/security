{
 "rule": "web-injection-probe",
 "cases": [
  {"name": "quote or", "match": true, "events": [{"EventType": "web", "uri": "/search/faq?q=' or 1=1 --", "query": "' or 1=1 --", "method": "GET", "status": "200"}]},
  {"name": "union select", "match": true, "events": [{"EventType": "web", "uri": "/search/faq?q=1 union select 1,2", "query": "1 union select 1,2", "method": "GET", "status": "200"}]},
  {"name": "path traversal", "match": true, "events": [{"EventType": "web", "uri": "/search/faq?q=../../etc/passwd", "query": "../../etc/passwd", "method": "GET", "status": "200"}]},
  {"name": "drop", "match": true, "events": [{"EventType": "web", "uri": "/search/faq?q=1; drop table a", "query": "1; drop table a", "method": "GET", "status": "200"}]},
  {"name": "upper case is the same", "match": true, "events": [{"EventType": "web", "uri": "/search/faq?q=1' OR '1'='1", "query": "1' OR '1'='1", "method": "GET", "status": "200"}]},
  {"name": "an ordinary search", "match": false, "events": [{"EventType": "web", "uri": "/search/faq?q=mortgage rate", "query": "mortgage rate", "method": "GET", "status": "200"}]},
  {"name": "union alone", "match": false, "events": [{"EventType": "web", "uri": "/search/faq?q=credit union", "query": "credit union", "method": "GET", "status": "200"}]},
  {"name": "the branch search is filtered", "match": false, "events": [{"EventType": "web", "uri": "/search/branches?q=credit%20union%20select%20branch", "query": "credit union select branch", "method": "GET", "status": "200"}]}
 ]
}
