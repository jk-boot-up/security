{
 "rule": "new-admin-user",
 "cases": [
  {"name": "useradd with -G sudo", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/sbin/useradd", "CommandLine": "useradd -m -G sudo x", "User": "emp100"}]},
  {"name": "useradd with -G wheel", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/sbin/useradd", "CommandLine": "useradd -m -G wheel x", "User": "emp100"}]},
  {"name": "useradd with user id 0", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/sbin/useradd", "CommandLine": "useradd -u 0 -g 0 x", "User": "emp100"}]},
  {"name": "useradd with -o", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/sbin/useradd", "CommandLine": "useradd -o -N x", "User": "emp100"}]},
  {"name": "adduser with -G sudo", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/sbin/adduser", "CommandLine": "adduser -G sudo x", "User": "emp100"}]},
  {"name": "usermod adds to sudo", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/sbin/usermod", "CommandLine": "usermod -aG sudo x", "User": "emp100"}]},
  {"name": "usermod adds to wheel", "match": true, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/sbin/usermod", "CommandLine": "usermod -aG wheel x", "User": "emp100"}]},
  {"name": "useradd in an ordinary group", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/sbin/useradd", "CommandLine": "useradd -m -G developers x", "User": "emp100"}]},
  {"name": "usermod in an ordinary group", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/sbin/usermod", "CommandLine": "usermod -aG developers x", "User": "emp100"}]},
  {"name": "id with the same words", "match": false, "events": [{"ParentImage": "/bin/bash", "Image": "/usr/bin/id", "CommandLine": "id -G sudo -u 0 -o", "User": "emp100"}]},
  {"name": "provisioning by the service account", "match": false, "events": [{"ParentImage": "/usr/bin/python3", "Image": "/usr/sbin/useradd", "CommandLine": "useradd -m -G sudo x", "User": "svc-provision"}]}
 ]
}
